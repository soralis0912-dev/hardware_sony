binder_call(vendor_hal_tuner_client, vendor_hal_tuner_server)
binder_call(vendor_hal_tuner_server, vendor_hal_tuner_client)

add_hwservice(vendor_hal_tuner_server, vendor_hal_tuner_hwservice)

allow vendor_hal_tuner_client vendor_hal_tuner_hwservice:hwservice_manager find;

# dtvserver lives on /system, so it cannot carry a vendor attribute
binder_call(dtvserver, vendor_hal_tuner_server)
allow dtvserver vendor_hal_tuner_hwservice:hwservice_manager find;
